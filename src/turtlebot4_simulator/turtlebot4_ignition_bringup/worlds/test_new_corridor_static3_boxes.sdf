<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="test_new_corridor_static3_boxes">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <plugin name="ignition::gazebo::systems::Physics" filename="ignition-gazebo-physics-system"/>
    <plugin name="ignition::gazebo::systems::UserCommands" filename="ignition-gazebo-user-commands-system"/>
    <plugin name="ignition::gazebo::systems::SceneBroadcaster" filename="ignition-gazebo-scene-broadcaster-system"/>
    <plugin name="ignition::gazebo::systems::Contact" filename="ignition-gazebo-contact-system"/>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1.1</intensity>
      <direction>-0.5 0.1 -0.9</direction>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.82 0.82 0.82 1</ambient><diffuse>0.82 0.82 0.82 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="corridor_border">
      <static>true</static>
      <link name="north">
        <pose>4.00 2.10 1 0 0 0</pose>
        <collision name="collision"><geometry><box><size>10.40 0.20 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>10.40 0.20 2</size></box></geometry></visual>
      </link>
      <link name="south">
        <pose>4.00 -2.10 1 0 0 0</pose>
        <collision name="collision"><geometry><box><size>10.40 0.20 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>10.40 0.20 2</size></box></geometry></visual>
      </link>
      <link name="west">
        <pose>-1.10 0 1 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.20 4.40 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.20 4.40 2</size></box></geometry></visual>
      </link>
      <link name="east">
        <pose>9.10 0 1 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.20 4.40 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.20 4.40 2</size></box></geometry></visual>
      </link>
    </model>

    <model name="static_box_0">
      <pose>3.250 0.650 0.170 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.34 0.34 0.34</size></box></geometry>
          <material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.34 0.34 0.34</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name="static_box_1">
      <pose>4.000 -0.650 0.170 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.34 0.34 0.34</size></box></geometry>
          <material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.34 0.34 0.34</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name="static_box_2">
      <pose>4.750 0.650 0.170 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.34 0.34 0.34</size></box></geometry>
          <material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.34 0.34 0.34</size></box></geometry>
        </collision>
      </link>
    </model>
  </world>
</sdf>
