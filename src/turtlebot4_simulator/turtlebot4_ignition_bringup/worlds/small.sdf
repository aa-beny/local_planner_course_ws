<sdf version='1.9'>
  <world name='small'>
    <physics name='1ms' type='ignored'>
      <max_step_size>0.003</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <plugin name='ignition::gazebo::systems::Physics' filename='ignition-gazebo-physics-system'/>
    <plugin name='ignition::gazebo::systems::UserCommands' filename='ignition-gazebo-user-commands-system'/>
    <plugin name='ignition::gazebo::systems::SceneBroadcaster' filename='ignition-gazebo-scene-broadcaster-system'/>
    <plugin name='ignition::gazebo::systems::Contact' filename='ignition-gazebo-contact-system'/>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- 地面 -->
    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name='visual'>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 邊框：10x10，牆高 2m，關陰影 -->
    <model name='border'>
      <pose>0 0 0 0 0 0</pose>
      <static>true</static>

      <link name='wall1'>
        <pose>-5.005 0 1 0 0 0</pose>
        <collision name='wall1_collision'>
          <geometry><box><size>0.01 10.01 2</size></box></geometry>
        </collision>
        <visual name='wall1_visual'>
          <geometry><box><size>0.01 10.01 2</size></box></geometry>
          <cast_shadows>false</cast_shadows>
        </visual>
      </link>

      <link name='wall2'>
        <pose>5.005 0 1 0 0 0</pose>
        <collision name='wall2_collision'>
          <geometry><box><size>0.01 10.01 2</size></box></geometry>
        </collision>
        <visual name='wall2_visual'>
          <geometry><box><size>0.01 10.01 2</size></box></geometry>
          <cast_shadows>false</cast_shadows>
        </visual>
      </link>

      <link name='wall3'>
        <pose>0 5.005 1 0 0 0</pose>
        <collision name='wall3_collision'>
          <geometry><box><size>10.01 0.01 2</size></box></geometry>
        </collision>
        <visual name='wall3_visual'>
          <geometry><box><size>10.01 0.01 2</size></box></geometry>
          <cast_shadows>false</cast_shadows>
        </visual>
      </link>

      <link name='wall4'>
        <pose>0 -5.005 1 0 0 0</pose>
        <collision name='wall4_collision'>
          <geometry><box><size>10.01 0.01 2</size></box></geometry>
        </collision>
        <visual name='wall4_visual'>
          <geometry><box><size>10.01 0.01 2</size></box></geometry>
          <cast_shadows>false</cast_shadows>
        </visual>
      </link>
    </model>

    <!-- 四個 1x1x1 靜態方塊，放在框內 -->
    <model name='box1'>
      <static>true</static>
      <pose>2 2 0.5 0 0 0</pose>
      <link name='link'>
        <collision name='col'><geometry><box><size>1 1 1</size></box></geometry></collision>
        <visual name='vis'><geometry><box><size>1 1 1</size></box></geometry></visual>
      </link>
    </model>
    <model name='box2'>
      <static>true</static>
      <pose>-2 2 0.5 0 0 0</pose>
      <link name='link'>
        <collision name='col'><geometry><box><size>1 1 1</size></box></geometry></collision>
        <visual name='vis'><geometry><box><size>1 1 1</size></box></geometry></visual>
      </link>
    </model>
    <model name='box3'>
      <static>true</static>
      <pose>-2 -2 0.5 0 0 0</pose>
      <link name='link'>
        <collision name='col'><geometry><box><size>1 1 1</size></box></geometry></collision>
        <visual name='vis'><geometry><box><size>1 1 1</size></box></geometry></visual>
      </link>
    </model>
    <model name='box4'>
      <static>true</static>
      <pose>2 -2 0.5 0 0 0</pose>
      <link name='link'>
        <collision name='col'><geometry><box><size>1 1 1</size></box></geometry></collision>
        <visual name='vis'><geometry><box><size>1 1 1</size></box></geometry></visual>
      </link>
    </model>

    <!-- 太陽光關閉陰影，避免十字陰影 -->
    <light name='sun' type='directional'>
      <pose>0 0 10 0 0 0</pose>
      <direction>0 0 -1</direction>
      <cast_shadows>false</cast_shadows>
    </light>
  </world>
</sdf>