<sdf version='1.9'>
  <world name='big'>
    <physics name='1ms' type='ignored'>
      <max_step_size>0.003</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <plugin name='ignition::gazebo::systems::Physics' filename='ignition-gazebo-physics-system'/>
    <plugin name='ignition::gazebo::systems::UserCommands' filename='ignition-gazebo-user-commands-system'/>
    <plugin name='ignition::gazebo::systems::SceneBroadcaster' filename='ignition-gazebo-scene-broadcaster-system'/>
    <plugin name='ignition::gazebo::systems::Contact' filename='ignition-gazebo-contact-system'/>

    <gravity>0 0 -9.8</gravity>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- 地面 -->
    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name='visual'>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 外框：20x20，牆高 2m，厚 0.3m -->
    <model name='border'>
      <pose>0 0 1 0 0 0</pose>
      <static>true</static>
      <link name='wall_west'>
        <pose>-10.15 0 0 0 0 0</pose>
        <collision name='col'><geometry><box><size>0.3 20.3 2</size></box></geometry></collision>
        <visual name='vis'><geometry><box><size>0.3 20.3 2</size></box></geometry></visual>
      </link>
      <link name='wall_east'>
        <pose>10.15 0 0 0 0 0</pose>
        <collision name='col'><geometry><box><size>0.3 20.3 2</size></box></geometry></collision>
        <visual name='vis'><geometry><box><size>0.3 20.3 2</size></box></geometry></visual>
      </link>
      <link name='wall_north'>
        <pose>0 10.15 0 0 0 0</pose>
        <collision name='col'><geometry><box><size>20.3 0.3 2</size></box></geometry></collision>
        <visual name='vis'><geometry><box><size>20.3 0.3 2</size></box></geometry></visual>
      </link>
      <link name='wall_south'>
        <pose>0 -10.15 0 0 0 0</pose>
        <collision name='col'><geometry><box><size>20.3 0.3 2</size></box></geometry></collision>
        <visual name='vis'><geometry><box><size>20.3 0.3 2</size></box></geometry></visual>
      </link>
    </model>


    <!-- 預埋物件池：10 個方柱 + 10 個圓柱，初始藏在 z = -10 -->
    <!-- 方柱大小 0.5x0.5x0.5，圓柱半徑 0.3，高 0.6，皆 static -->
    <!-- 你若要改尺寸，記得在 ObstacleManager 的 radius 也同步調整 -->
    <!-- Boxes -->
    <model name='box_pool_0'><pose>0 0 -10 0 0 0</pose><static>true</static>
      <link name='link'><visual name='vis'><geometry><box><size>0.5 0.5 0.5</size></box></geometry></visual>
      <collision name='col'><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision></link>
    </model>
    <model name='box_pool_1'><pose>1 0 -10 0 0 0</pose><static>true</static>
